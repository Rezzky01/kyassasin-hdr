rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == 'fxzhHNEoDmOBQfoLxGoI0HPDR4q1';
    }

    // Email accounts must verify their email. Phone accounts are verified by Firebase OTP.
    function verifiedOrAdmin() {
      return signedIn() && (
        isAdmin()
        || request.auth.token.phone_number != null
        || request.auth.token.email_verified == true
      );
    }

    function activeUser() {
      return verifiedOrAdmin()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked != true;
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isAdmin()
        || (verifiedOrAdmin() && request.auth.uid == uid);

      allow create: if verifiedOrAdmin()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == (isAdmin() ? 'admin' : 'user')
        && request.resource.data.vip == false
        && request.resource.data.blocked == false;

      // Users may update only their own profile metadata, never role/VIP/block status.
      allow update: if isAdmin()
        || (verifiedOrAdmin()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['email', 'phone', 'loginMethod', 'lastLoginAt', 'displayName', 'photoURL']));

      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if activeUser();

      allow create: if activeUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.get('email', null)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.keys().hasOnly(['uid', 'email', 'text', 'createdAt']);

      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}