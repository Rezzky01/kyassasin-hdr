rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid == "fxzhHNEoDmOBQfoLxGoI0HPDR4q1"; }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.vip == false
        && request.resource.data.blocked == false
        && request.resource.data.role == (isAdmin() ? "admin" : "user");
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["email", "phone", "loginMethod", "lastLoginAt"]));
      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow update, delete: if isAdmin();
    }
  }
}