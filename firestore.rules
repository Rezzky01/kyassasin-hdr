rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked != true;
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.vip == false
        && request.resource.data.blocked == false
        && request.resource.data.loginMethod == 'anonymous';
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['email', 'phone', 'loginMethod', 'lastLoginAt', 'displayName', 'photoURL']);
      allow delete: if false;
    }
    match /messages/{messageId} {
      allow read: if activeUser();
      allow create: if activeUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == null
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.keys().hasOnly(['uid', 'email', 'text', 'createdAt']);
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}